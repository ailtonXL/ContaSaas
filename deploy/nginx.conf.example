# Ajuste dominio e certificado TLS antes de habilitar.
server {
    listen 443 ssl;
    server_name contasaas.seudominio.com;
    ssl_certificate /etc/letsencrypt/live/contasaas.seudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/contasaas.seudominio.com/privkey.pem;
    client_max_body_size 12m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    server_name contasaas.seudominio.com;
    return 301 https://$host$request_uri;
}
