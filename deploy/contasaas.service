[Unit]
Description=ContaSaas (web e automacoes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=contasaas
Group=contasaas
WorkingDirectory=/opt/ContaSaas
EnvironmentFile=/etc/contasaas.env
Environment=CONTASAAS_DATA=/var/lib/contasaas
Environment=COOKIE_SECURE=1
ExecStart=/usr/bin/python3 /opt/ContaSaas/app.py serve --host 127.0.0.1 --port 8000 --with-worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=contasaas
ReadWritePaths=/var/lib/contasaas

[Install]
WantedBy=multi-user.target
