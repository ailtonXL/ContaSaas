# Configure no ambiente do processo ou no EnvironmentFile do systemd.
# O aplicativo não carrega .env automaticamente. Nunca versione segredos reais.
CONTASAAS_DATA=/var/lib/contasaas
COOKIE_SECURE=1
BACKUP_RETENTION_DAYS=30
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=seu_usuario
SMTP_PASSWORD=defina_no_ambiente
SMTP_FROM=contabilidade@suaempresa.com
WHATSAPP_TOKEN=defina_no_ambiente
WHATSAPP_PHONE_ID=123456789
WHATSAPP_TEMPLATE=lembrete_pendencias
WHATSAPP_LANGUAGE=pt_BR
WHATSAPP_API_VERSION=v23.0
